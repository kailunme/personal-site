---
import '../styles/globals.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = 'kai',
  description = 'A digital space blending the digital with the organic.',
  lang,
} = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/seo/favicon.ico" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Aldrich&family=Source+Code+Pro:wght@200;300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <ClientRouter fallback="swap" />
  </head>
  <body class="ua-body" data-lang={lang}>
    <slot />
  </body>
  <script>
    import { restoreBackgroundPlayback } from '../lib/backgroundVideo';

    let preserveScroll = false;
    let savedScroll: { left: number; top: number } | undefined;

    document.addEventListener('astro:before-preparation', event => {
      preserveScroll = event.info?.preserveScroll === true;
      savedScroll = undefined;
    });

    document.addEventListener('astro:before-swap', event => {
      if (preserveScroll) {
        savedScroll = { left: window.scrollX, top: window.scrollY };
      }
      // Capture a fully visible new page, rather than restarting each entrance.
      event.newDocument.documentElement.setAttribute('data-page-navigation', '');
    });

    void restoreBackgroundPlayback();
    document.addEventListener('astro:page-load', restoreBackgroundPlayback);

    function applyLang() {
      const path = window.location.pathname;
      if (path.startsWith('/zh')) {
        document.body.setAttribute('data-lang', 'zh');
      } else if (path.startsWith('/ja')) {
        document.body.setAttribute('data-lang', 'ja');
      } else {
        document.body.removeAttribute('data-lang');
      }
      // Force np-title to re-inherit --font-body after cache restore
      document.querySelectorAll('.np-title').forEach(el => {
        (el as HTMLElement).style.fontFamily = '';
        (el as HTMLElement).style.fontFamily = 'var(--font-body)';
      });
    }
    document.addEventListener('astro:after-swap', applyLang);
    document.addEventListener('astro:after-swap', () => {
      if (!savedScroll) return;
      window.scrollTo({ ...savedScroll, behavior: 'instant' });
      history.replaceState({
        ...history.state,
        scrollX: window.scrollX,
        scrollY: window.scrollY,
      }, '');
      savedScroll = undefined;
      preserveScroll = false;
    });
  </script>
</html>
