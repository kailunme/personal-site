---
import type { SidebarContent } from '../i18n/content';
import { sidebar } from '../i18n/content';
import IPodPlayer from './iPodPlayer';
import { MixedText } from './MixedText';

interface Props { content?: SidebarContent; }
const { content = sidebar.en } = Astro.props;
---

<style>
  .stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 0;
    border-bottom: 1px dashed rgba(180,205,235,0.5);
    font-family: var(--font-body);
    font-size: 13px;
  }
  .stat-row:last-child { border-bottom: none; }
  .stat-label { color: var(--ua-text-muted-light); }
  .stat-value {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--ua-text-muted);
    background: rgba(255,255,255,0.6);
    border: 1px solid rgba(190,210,230,0.6);
    border-radius: 8px;
    padding: 1px 8px;
    box-shadow: inset 0 1px 2px rgba(255,255,255,0.9), 0 1px 2px rgba(100,140,190,0.07);
  }

  .button-gif-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 17px 14px;
  }
  .site-button-img {
    opacity: 0.75;
    image-rendering: pixelated;
    transition: opacity 0.2s;
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(100,140,190,0.18), 0 1px 2px rgba(100,140,190,0.1);
  }
  .site-button-img:hover { opacity: 1; }
</style>

<!-- NOW PLAYING (iPod nano) -->
<div class="ua-panel fade-up motion-delay-2">
  <div class="ua-toolbar">
    <img src="/images/xbutton.png" alt="" class="ua-xbtn" />
    <span class="ua-toolbar-title">NOW PLAYING</span>
  </div>
  <div style="padding:14px 10px; display:flex; justify-content:center;">
    <IPodPlayer title={content.nowPlayingTitle} artist={content.nowPlayingArtist} client:load transition:persist="ipod-player" />
  </div>
</div>

<!-- STATS -->
<div class="ua-panel fade-up motion-delay-3">
  <div class="ua-toolbar">
    <img src="/images/xbutton.png" alt="" class="ua-xbtn" />
    <span class="ua-toolbar-title">{content.statsTitle}</span>
  </div>
  <div style="padding:10px 14px;">
    {content.stats.map(s => (
      <div class="stat-row">
        <span class="stat-label"><MixedText text={s.label} /></span>
        <span class="stat-value"><MixedText text={s.value} /></span>
      </div>
    ))}
  </div>
</div>

<!-- SITE BUTTON -->
<div class="ua-panel fade-up motion-delay-4">
  <div class="ua-toolbar">
    <img src="/images/xbutton.png" alt="" class="ua-xbtn" />
    <span class="ua-toolbar-title">{content.buttonTitle}</span>
  </div>
  <div class="button-gif-wrap">
    <img src="/images/UnicodeAngelButton.gif" alt="unicodeangel" class="site-button-img" />
    <span style="font-family:var(--font-body);font-size:10px;color:var(--ua-text-muted-light);opacity:0.7;text-align:center;line-height:1.5;">
      <MixedText text="Inspired by " /> <a href="https://unicodeangel.neocities.org" target="_blank" style="color:inherit;text-decoration:underline;text-underline-offset:2px;"><MixedText text="unicodeangel" /></a>
    </span>
    <span style="font-family:var(--font-body);font-size:10px;color:var(--ua-text-muted-light);opacity:0.7;text-align:center;line-height:1.5;">
      <MixedText text="Icons from " /> <a href="https://pixeliconlibrary.com/" target="_blank" style="color:inherit;text-decoration:underline;text-underline-offset:2px;"><MixedText text="Pixel Icon Library" /></a> <MixedText text=" by " /> <a href="https://hackernoon.com/" target="_blank" style="color:inherit;text-decoration:underline;text-underline-offset:2px;"><MixedText text="HackerNoon" /></a>
    </span>
  </div>
</div>
