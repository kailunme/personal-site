---
import type { LinksContent } from '../i18n/content';
import type { NavContent } from '../i18n/content';
import NavBar from './NavBar.astro';
import ControlPanel from './ControlPanel.astro';
import { pageTransition } from '../lib/pageTransitions';

interface Props {
  content: LinksContent;
  nav: NavContent;
  locale: 'en' | 'zh' | 'ja';
}
const { content, nav, locale } = Astro.props;
---

<div class="links-grid" transition:name="site-content" transition:animate={pageTransition}>
  <div class="links-col-left">
    <NavBar content={nav} />
    <ControlPanel current={locale} />
  </div>

  <!-- middle column: MISC + NEOWEB (panels 4 & 5) -->
  <div class="links-col-main">
    {content.categories.slice(3).map((cat, i) => (
      <div class:list={['ua-panel', 'fade-up', `motion-delay-${i + 1}`]}>
        <div class="lp-toolbar">
          <span class="lp-cat-title">{cat.name}</span>
          <img src="/images/xbutton.png" alt="" class="ua-xbtn" />
        </div>
        <div class="link-list-wide">
          {cat.links.map(link => (
            <div class="link-row">
              <span class="link-bullet">▸</span>
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-title">{link.title}</a>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- right column: WORK + GOOGLE + BROWSE (panels 1–3) -->
  <div class="links-col-right">
    {content.categories.slice(0, 3).map((cat, i) => (
      <div class:list={['ua-panel', 'fade-up', `motion-delay-${i + 1}`]}>
        <div class="lp-toolbar">
          <span class="lp-cat-title">{cat.name}</span>
          <img src="/images/xbutton.png" alt="" class="ua-xbtn" />
        </div>
        <div class="link-list">
          {cat.links.map(link => (
            <div class="link-row">
              <span class="link-bullet">▸</span>
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-title">{link.title}</a>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
